    "vuetify": "^3.5.10",
    "webfontloader": "^1.0.0"
  },
  "devDependencies": {
    "@pinia/testing": "^0.1.7",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^7.32.0",
    "eslint-plugin-vue": "^8.0.3",
    "jsdom": "^26.1.0",
    "vite": "^6.0.0",
    "vite-plugin-vuetify": "^2.1.1",
